# Build output / deps
build/
tools/d4cloth/build/
vcpkg_installed/
*.obj
*.exe
*.dll
*.pdb
*.ilk

# Local backups. One tree only — backup-src.bat and the rebuild script both write .Backups,
# and a second _backups/ had accumulated 63 MB of near-duplicates alongside it.
.Backups/

# Large captured data + archives
*.tgz
tools/d4cloth/corpus/
tools/d4cloth/reports/

# Logs and generated diagnostics
build_log.txt
build_errors.txt
d4browser_log_*.txt
cloth_console.txt
cloth_overlay_report.txt
cloth_parse.txt
cloth_cage_diag.txt
cloth_audit.csv
cloth_audit_summary.txt
icon_audit.txt
detail_mask_probe.txt
d4cloth_build_log.txt
d4cloth_extract_log.txt
rebuild_out.txt

# TACT decryption keys — NOT distributed with this repo.
# The upstream project fetches them at runtime and this one does the same. Shipping
# Blizzard's decryption keys in a public repo is a different thing from a tool that can
# use keys the user supplies, and only the second is defensible. Keep it that way.
.Resources/d4_tact_keys*.txt
tactkeys/
*.keys

# Release output and build leftovers — generated, never committed.
dist/
build.del/
