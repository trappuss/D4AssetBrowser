{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "diablo4assetbrowsernative",
  "version": "2.1.0",
  "description": "Native C++/Qt6 Diablo IV asset browser — a rewrite in d4analyzer's exact code stack (C++17, Qt6 Widgets, OpenGL, CascLib, fastgltf, tinygltf, Draco).",
  "homepage": "https://github.com/DiabloTools/Diablo4Tools-Releases",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "widgets",
        "opengl",
        "gui",
        "png",
        "jpeg"
      ]
    },
    "qtsvg",
    "fastgltf",
    "tinygltf",
    "zlib",
    "lz4"
  ],
  "builtin-baseline": "f89a4a1da4e3176a8d1a14c1825b9b2f98e48843"
}
