{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "d4assetbrowser",
  "version": "2.4.1",
  "description": "Native C++/Qt6 Diablo IV asset browser and 3D wardrobe studio — reads the installed game's CASC storage directly.",
  "homepage": "https://github.com/trappuss/D4AssetBrowser",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "widgets",
        "opengl",
        "gui",
        "png",
        "jpeg"
      ]
    },
    "qtsvg",
    "zlib",
    "lz4"
  ],
  "builtin-baseline": "8d3373d5dcd122dad696bcbad1a58ffe64e29284"
}
