{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "d4shader",
  "version": "0.1.0",
  "description": "Feasibility probe: are Diablo IV's compiled shaders reachable and reusable?",
